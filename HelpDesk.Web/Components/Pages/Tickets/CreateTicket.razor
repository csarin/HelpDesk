@page "/tickets/create"
@using Helpdesk.Application.Models
@inject HelpDesk.Web.ViewModels.Tickets.CreateTicketViewModel ViewModel

<h3>Create Ticket</h3>

<EditForm Model="ViewModel.Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Title</label>
        <InputText @bind="ViewModel.Model.Title" />
    </div>

    <div>
        <label>Description</label>
        <InputTextArea @bind="ViewModel.Model.Description" />
    </div>

    <div>
        <label>Category Id (optional)</label>
        <InputNumber @bind="ViewModel.Model.CategoryId" />
    </div>

    <button type="submit">Create</button>
</EditForm>

@if (ViewModel.CreatedTicketId is not null)
{
    <p>Ticket created with Id: @ViewModel.CreatedTicketId</p>
}
@if (!string.IsNullOrEmpty(ViewModel.Error))
{
    <p class="text-danger">@ViewModel.Error</p>
}
@if (ViewModel.IsBusy)
{
    <p>Creating ticket...</p>
}

@code {
    protected override void OnInitialized()
    {

    }

    private async Task HandleValidSubmit()
    {
        await ViewModel.CreateAsync();
    }
}
